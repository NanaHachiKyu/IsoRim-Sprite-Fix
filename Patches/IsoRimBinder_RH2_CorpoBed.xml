<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Binds R3D_MyModelPack_RH2_CorpoBed to RH2_CorpoBed when IsoRim has Api 2 or later (the fields it uses); an older IsoRim leaves the thing as it is. -->
  <Operation Class="IsoRimPackGate.PatchOperation_IfIsoRimApi">
    <minVersion>2</minVersion>
    <apply Class="PatchOperationAdd">
      <xpath>/Defs/IsoRim.ModelDef[defName="R3D_MyModelPack_RH2_CorpoBed"]</xpath>
      <value><thingDef>RH2_CorpoBed</thingDef></value>
    </apply>
  </Operation>
</Patch>
